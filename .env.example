# 复制为 .env.local 后填写；未设置则不显示赞助入口
VITE_BMC_URL=https://www.buymeacoffee.com/your-username

# ---- 崩溃上报（Sentry）----
# 只上报程序异常，不会发送简历内容、表单字段或照片；留空则完全不上报
VITE_SENTRY_DSN=
# 设为 1 时在本地开发也发送上报（仅用于验证接入，平时不要开）
VITE_SENTRY_DEV=

# 以下三项只在 `npm run build` 上传 source map 时读取，不会进入前端产物
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- AI 文案优化 ----
# 前端不再需要构建期开关：编辑器会请求 /api/ai/status，
# Worker 配了 key 才显示按钮。
# 下面这个 key 只在服务端使用：本地由 vite 中间件读取，生产写入 Worker Secret。
# 绝不能加 VITE_ 前缀，否则会被打包进前端产物。
OPENCODE_GO_API_KEY=
# 可选，默认 deepseek-v4.1-flash
AI_MODEL=
# 可选：主模型连续失败时的一次性兜底，默认 mimo-v2.6-flash
AI_FALLBACK_MODEL=
# 可选，默认 OpenCode Go 的 chat/completions 端点
AI_BASE_URL=
